# ==============================================================================
# Mostafa Nagdy Portfolio Environment Variables
# ==============================================================================
# Copy this file to .env.local to configure your local or production environment.
# Never commit .env.local or sensitive tokens into Git!

# ------------------------------------------------------------------------------
# 1. Vercel REST API Configuration (Optional)
# ------------------------------------------------------------------------------
# Required only if you want real-time Vercel deployment status badges & metadata.
# Create a read-only or full-access token at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Optional: If your deployments belong to a Vercel Team instead of a personal account,
# supply your Team ID (starts with "team_") or Team slug here. Leave empty for personal accounts.
VERCEL_TEAM_ID=

# ------------------------------------------------------------------------------
# 2. GitHub REST API Configuration (Optional)
# ------------------------------------------------------------------------------
# Optional: Increases rate limits from 60 req/hr (unauthenticated) to 5,000 req/hr.
# Generate a fine-grained or classic token at: https://github.com/settings/tokens
# Minimal scope required: "public_repo" (read-only)
GITHUB_TOKEN=

# Optional: Secret used to verify GitHub webhook payloads for automatic repository sync.
GITHUB_WEBHOOK_SECRET=


# Visitor Intelligence (optional until enabled)
# MongoDB Atlas connection string; never commit real credentials.
MONGODB_URI=
MONGODB_DB=nagedy_portfolio
# Set a strong unique admin password in Vercel Environment Variables.
ADMIN_PASSWORD=
# Random secret of at least 32 characters for signing admin sessions.
ADMIN_SESSION_SECRET=
